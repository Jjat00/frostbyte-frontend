# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

# WebSocket Configuration
VITE_WS_BASE_URL=ws://localhost:8000

# App Configuration
VITE_APP_NAME=Frostbyte
VITE_APP_ENV=development

# Google Sign-In (login de clientes con Google)
# OAuth 2.0 Client ID (tipo "Web application") de Google Cloud Console.
# Debe coincidir con GOOGLE_CLIENT_ID del backend.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Mapbox (mapa de domicilio en el checkout de pedidos)
# Token PÚBLICO (pk.*) desde https://account.mapbox.com/access-tokens/
# Sin token, el checkout de domicilio usa solo geolocalización (sin mapa visual).
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Feature Flags
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_GAMES=true
VITE_ENABLE_AI_GENERATOR=true
